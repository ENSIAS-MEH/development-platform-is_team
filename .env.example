# Copier en .env à la racine du repo : cp .env.example .env

# PostgreSQL
POSTGRES_DB=mentorpath_db
POSTGRES_USER=mentorpath_user
POSTGRES_PASSWORD=mentorpath_pass
POSTGRES_PORT=5432

# Backend
BACKEND_PORT=8080
JWT_SECRET=mentorpath_secret_key_must_be_at_least_32_chars_long_2024

# Redis
REDIS_PORT=6379

# Frontend (Docker)
FRONTEND_PORT=4200
